    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "@opennextjs/cloudflare": "^1.12.1",
    "@types/node": "^24.2.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.30.0"
  }
