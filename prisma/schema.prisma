generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FIRM_ADMIN
  ADVISOR
  CLIENT_ADMIN
  CLIENT_CONTRIBUTOR
  CLIENT_VIEWER
}

enum DataSource {
  CSV
  XERO
  MANUAL
}

enum SubscriptionStatus {
  ACTIVE
  REVIEW
  CANCELLED
}

enum RecommendationState {
  DRAFT
  APPROVED
  PUBLISHED
  DISMISSED
}

enum OutcomeState {
  ESTIMATED
  ACCEPTED
  DISMISSED
  IMPLEMENTED
  VERIFIED
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

model Firm {
  id String @id @default(cuid())
  name String
  primaryColour String @default("#18324B")
  accentColour String @default("#1D7785")
  disclaimer String?
  memberships Membership[]
  clients Client[]
  createdAt DateTime @default(now())
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  externalSubject String? @unique
  memberships Membership[]
  auditEvents AuditEvent[]
  createdAt DateTime @default(now())
}

model Membership {
  id String @id @default(cuid())
  firmId String
  userId String
  clientId String?
  role Role
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@unique([firmId, userId, clientId])
}

model Client {
  id String @id @default(cuid())
  firmId String
  name String
  abn String?
  gstMode String @default("INCLUSIVE")
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  memberships Membership[]
  imports ImportBatch[]
  transactions Transaction[]
  subscriptions Subscription[]
  recommendations Recommendation[]
  reports ReportSnapshot[]
  connections DataConnection[]
  auditEvents AuditEvent[]
  createdAt DateTime @default(now())
  @@index([firmId])
}

model ImportBatch {
  id String @id @default(cuid())
  firmId String
  clientId String
  filename String
  mapping Json
  source DataSource @default(CSV)
  importedRows Int @default(0)
  rejectedRows Int @default(0)
  createdAt DateTime @default(now())
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  @@index([firmId, clientId])
}

model Transaction {
  id String @id @default(cuid())
  firmId String
  clientId String
  importId String?
  source DataSource
  providerId String?
  accountName String?
  description String
  normalisedMerchant String
  date DateTime
  amount Decimal @db.Decimal(14, 2)
  gstAmount Decimal? @db.Decimal(14, 2)
  sourceFingerprint String
  originalRow Json?
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  import ImportBatch? @relation(fields: [importId], references: [id], onDelete: SetNull)
  @@unique([firmId, clientId, sourceFingerprint])
  @@index([firmId, clientId, normalisedMerchant, date])
}

model Subscription {
  id String @id @default(cuid())
  firmId String
  clientId String
  provider String
  category String
  billingCycle String
  amount Decimal @db.Decimal(14, 2)
  annualCost Decimal @db.Decimal(14, 2)
  ownerName String?
  renewalDate DateTime?
  noticeDays Int?
  status SubscriptionStatus @default(ACTIVE)
  publicNotes String?
  internalNotes String?
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]
  @@index([firmId, clientId, status])
}

model Recommendation {
  id String @id @default(cuid())
  firmId String
  clientId String
  subscriptionId String?
  type String
  title String
  rationale String
  internalNotes String?
  clientWording String?
  confidence Confidence
  estimatedSaving Decimal @db.Decimal(14, 2)
  effort String
  assumptions Json
  evidence Json
  state RecommendationState @default(DRAFT)
  outcome OutcomeState @default(ESTIMATED)
  verifiedSaving Decimal? @db.Decimal(14, 2)
  approvedAt DateTime?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  @@index([firmId, clientId, state])
}

model ReportSnapshot {
  id String @id @default(cuid())
  firmId String
  clientId String
  periodStart DateTime
  periodEnd DateTime
  version Int
  snapshot Json
  blobUrl String?
  createdAt DateTime @default(now())
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@unique([clientId, periodStart, periodEnd, version])
}

model DataConnection {
  id String @id @default(cuid())
  firmId String
  clientId String
  provider String
  providerTenantId String?
  status String
  secretReference String?
  syncCursor String?
  lastSyncedAt DateTime?
  createdAt DateTime @default(now())
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@index([firmId, clientId, provider])
}

model AuditEvent {
  id String @id @default(cuid())
  firmId String
  clientId String?
  actorId String?
  action String
  entityType String
  entityId String?
  summary Json
  createdAt DateTime @default(now())
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([firmId, clientId, createdAt])
}
