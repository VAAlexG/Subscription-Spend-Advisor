{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subscription-spend-advisor",
  "account_id": "826b80fa02df6ce82a18cfa9efe8bdcb",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "subscription-spend-advisor-db",
      "database_id": "642acf2d-081d-452b-8ce1-763010287775",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "subscription-spend-advisor-files"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AUTH_MODE": "access",
    "FIRM_ID": "firm_va",
    "FIRM_NAME": "Versatile Accounting",
    "INITIAL_ADMIN_EMAIL": "alexg@versatileaccounting.com.au"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
